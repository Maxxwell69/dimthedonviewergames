generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  wheels       Wheel[]
}

model Wheel {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String    @default("Viewer Games")
  description       String    @default("")
  isActive          Boolean   @default(true)
  displayToken      String    @unique @default(cuid())
  webhookSecret     String    @unique @default(cuid())
  removeOnWin       Boolean   @default(true)
  spinDurationMs    Int       @default(8000)
  soundEnabled      Boolean   @default(true)
  celebrateEnabled  Boolean   @default(true)
  spinVolume        Int       @default(80)
  celebrateVolume   Int       @default(95)
  allowDuplicates   Boolean   @default(false)
  colorPrimary      String    @default("#5c0a14")
  colorSecondary    String    @default("#0a0a0a")
  colorAccent       String    @default("#c9a24d")
  hubImageUrl       String?   @db.Text
  isSpinning        Boolean   @default(false)
  spinStartedAt     DateTime?
  spinEndsAt        DateTime?
  spinTargetAngle   Float?
  currentWinner     String?
  lastWinnerAt      DateTime?
  entriesText       String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  entries           Entry[]
  winners           Winner[]

  @@index([userId])
  @@index([userId, isActive])
}

model Entry {
  id             String   @id @default(cuid())
  wheelId        String
  wheel          Wheel    @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  label          String
  weight         Int      @default(1)
  tiktokUsername String?
  tiktokUserId   String?
  source         String   @default("manual")
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([wheelId, label])
  @@index([wheelId])
}

model Winner {
  id        String   @id @default(cuid())
  wheelId   String
  wheel     Wheel    @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now())

  @@index([wheelId])
}

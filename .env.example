# Postgres (Railway provides this automatically when you add a Postgres plugin)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
# Must be a real random string (16+ chars). Do NOT leave the placeholder text.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# On Railway, set these on the WEB service (not Postgres):
# AUTH_SECRET=<random>
# AUTH_URL=https://domthedonviewergames-production.up.railway.app
# AUTH_TRUST_HOST=true
# DATABASE_URL=${{Postgres.DATABASE_URL}}


# Postgres (Railway provides this automatically when you add a Postgres plugin)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional: set on Railway to your public domain
# AUTH_URL="https://your-app.up.railway.app"
